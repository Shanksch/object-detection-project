# =========================================
# Object Detection Studio — Environment
# =========================================

# Server
HOST=0.0.0.0
PORT=8080
DEBUG=false
WORKERS=1

# Model
MODEL_WEIGHTS=best.pt
IMAGE_SIZE=416
CONFIDENCE_THRESHOLD=0.5
IOU_THRESHOLD=0.45
DEVICE=auto

# Upload limits
MAX_FILE_SIZE=10485760

# Training
TRAIN_EPOCHS=25
TRAIN_BATCH_SIZE=16
DATA_DOWNLOAD_URL=https://github.com/Shanksch/data/raw/refs/heads/main/object_detection_dataset.zip

# Rate limiting
RATE_LIMIT=30/minute

# Logging
LOG_LEVEL=INFO
LOG_JSON=false
